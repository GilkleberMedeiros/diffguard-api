# Variáveis de ambiente — copie este arquivo para .env e preencha os valores

# ── LLM ────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai          # openai | google | ollama
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-...
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ── Limites ────────────────────────────────────────────────────────────────────
MAX_DOCUMENT_SIZE_KB=2048
TASK_TTL_SECONDS=3600        # tempo máximo de vida de uma tarefa na memória (s)

# ── Worker ─────────────────────────────────────────────────────────────────────
WORKER_BACKEND=background    # background | celery
CELERY_BROKER_URL=redis://localhost:6379/0   # usado apenas se WORKER_BACKEND=celery

# ── Aplicação ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=pt-BR
